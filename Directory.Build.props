<Project>
  <PropertyGroup>
    <!--
      Compiler and test products stay under the repository-owned bin tree on every
      platform. Platform build scripts remove their transient work before returning.
    -->
    <AetherXivWorkRoot Condition="'$(AetherXivWorkRoot)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'bin', 'build', '.work', '$(Configuration)'))</AetherXivWorkRoot>
    <BaseOutputPath>$(AetherXivWorkRoot)/out/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(AetherXivWorkRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <TargetFramework>net10.0</TargetFramework>
    <!-- .NET 10 no longer infers this reliably from Microsoft.NET.Test.Sdk.
         Without it, dotnet test reports success while silently running zero tests. -->
    <IsTestProject Condition="'$(IsTestProject)' == '' and '$(MSBuildProjectName)' != '' and $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Version>2.0.0-foundation</Version>
    <InformationalVersion>2.0.0+build.21998</InformationalVersion>
    <AetherXivBuildNumber>21998</AetherXivBuildNumber>
  </PropertyGroup>
</Project>
