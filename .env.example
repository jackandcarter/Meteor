# Copy this file to .env before starting the Compose stack.
# Both passwords are required. Use long, unique values for hosted servers.
AETHERXIV_DB_ROOT_PASSWORD=
AETHERXIV_DB_PASSWORD=

# The address sent by Lobby to game clients for the World service.
# Keep 127.0.0.1 for a client on the Docker host, or set a LAN/public IP or DNS name.
AETHERXIV_PUBLIC_HOST=127.0.0.1

# Published server ports. Change the matching firewall/NAT rules if customized.
AETHERXIV_LAUNCHER_SERVICES_PORT=8080
AETHERXIV_WORLD_PORT=54992
AETHERXIV_LOBBY_PORT=54994

# Server policy.
AETHERXIV_LAUNCHER_ALLOW_ACCOUNT_CREATE=true
AETHERXIV_ENABLE_LAUNCHER_SERVICES=true
