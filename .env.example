# Copy to .env and adjust for your machine. docker compose auto-loads .env.

# App database user password, shared by mariadb and all three services.
AETHERXIV_DB_PASSWORD=aether_dev

# MariaDB root password (root is only used for container bootstrap).
AETHERXIV_DB_ROOT_PASSWORD=aether_dev_root

# Host port the MariaDB container is published on.
AETHERXIV_DB_BIND=3306

# Host port for the lobby service.
AETHERXIV_LOBBY_BIND=54994

# Host port for the world service.
AETHERXIV_WORLD_BIND=54992

# Host port for the map service.
AETHERXIV_MAP_BIND=1989
