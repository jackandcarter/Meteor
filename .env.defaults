# Checked-in local development defaults.
# Scripts load this first, then .env.local if you need machine-specific overrides.

# MariaDB/MySQL admin connection used only for setup/import.
# Leave DB_ADMIN_USER empty to try your OS login first; setup-local-db can
# fall back to sudo root on Ubuntu socket-auth installs.
DB_HOST=localhost
DB_PORT=3306
DB_ADMIN_USER=
DB_ADMIN_PASS=
DB_ADMIN_SUDO=0

# Database and application account used by the AetherXIV servers and PHP services.
# These are local development defaults. Change DB_APP_PASS and AETHER_DB_PASS
# in .env.local if this machine is exposed beyond your local dev environment.
DB_NAME=ffxiv_server
DB_APP_HOST=127.0.0.1
DB_APP_PORT=3306
DB_APP_USER=aetherxiv
DB_APP_PASS=aether_dev
DB_APP_HOSTS="localhost 127.0.0.1"

AETHER_DB_HOST=127.0.0.1
AETHER_DB_PORT=3306
AETHER_DB_NAME=ffxiv_server
AETHER_DB_USER=aetherxiv
AETHER_DB_PASS=aether_dev

# Legacy compatibility for old local scripts/configs and existing deployments.
METEOR_DB_HOST=127.0.0.1
METEOR_DB_PORT=3306
METEOR_DB_NAME=ffxiv_server
METEOR_DB_USER=aetherxiv
METEOR_DB_PASS=aether_dev

# Service bind addresses. Public VPS installs usually set LOBBY_IP and
# WORLD_IP to 0.0.0.0, while MAP_IP can stay 127.0.0.1 when it runs on the
# same host as the world server.
WEB_BIND=127.0.0.1
LOBBY_IP=127.0.0.1
WORLD_IP=127.0.0.1
MAP_IP=127.0.0.1

# Optional path to your local user-owned FFXIV 1.x client root.
# If empty, prepare-client-data.sh can use Echo Gate's saved profile or prompt.
CLIENT_DIR=
